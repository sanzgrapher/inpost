{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inpost",
  "version": "0.1.1",
  "identifier": "com.inpost.desktop",
  "build": {
    "beforeDevCommand": "npm run build:mcp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:mcp && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inpost",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/mcp/stdio.mjs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
